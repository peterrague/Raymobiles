# Neon connection string. Use the pooled connection string on Vercel.
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/batrobas?sslmode=require

# openssl rand -base64 32
AUTH_SECRET=

# Google OAuth web client.
# Redirect URI: http://localhost:3000/api/auth/callback/google
# and https://<your-vercel-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# First Google sign-in is allowed only for this address, and only while the
# users table is empty. That person becomes the admin.
ADMIN_EMAIL=admin@example.com

# Optional locally. Vercel sets the host automatically when AUTH_TRUST_HOST is not required;
# Auth.js is configured with trustHost.
AUTH_URL=http://localhost:3000
